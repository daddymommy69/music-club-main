# Copy this file to .env.local for local development.
# In production, set these as Environment Variables in your Vercel project settings.

# --- Database (Phase 0) ---
# Any Postgres connection string works: Vercel Postgres (Neon), Supabase, etc.
# See README.md "1. Database" for how to get this.
DATABASE_URL=

# --- Twilio (SMS) ---
# See README.md "2. Twilio (SMS)" for how to get these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The phone number you buy in Twilio, in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# --- Resend (Email) ---
# See README.md "3. Resend (Email)" for how to get this.
RESEND_API_KEY=
# Must be an address on a domain you've verified with Resend.
EMAIL_FROM_ADDRESS=

# --- App config ---
# Shown in confirmation/release messages.
NEXT_PUBLIC_CLUB_NAME="Music Club"

# A password you make up yourself — protects /api/send and /api/cycles
# so only you can trigger a manual send or start a new cycle.
ADMIN_SECRET=

# A second password you make up yourself — Vercel automatically sends this
# as a Bearer token when it calls /api/cron/send on schedule. Set the exact
# same value here and in Vercel's project environment variables.
CRON_SECRET=
