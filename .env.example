# Copy this file to .env.local for local development.
# In production, set these as Environment Variables in your Vercel project settings.

# --- Database ---
# Any Postgres connection string works: Vercel Postgres (Neon), Supabase, etc.
# See README.md "1. Database" for how to get this.
DATABASE_URL=

# --- Site URL ---
# The real, deployed domain — every text/email link (the /you link, drop
# links) and every "share this" display string is built from this, so
# there's nothing hardcoded to change later if the domain changes.
# Local dev works with this unset (falls back to http://localhost:3000).
# In Vercel, set it to your real domain, e.g. https://gooberz.club
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Twilio (SMS) ---
# See README.md "2. Twilio (SMS)" for how to get these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The phone number you buy in Twilio, in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# --- Resend (Email) ---
# See README.md "3. Resend (Email)" for how to get this.
RESEND_API_KEY=
# Must be an address on a domain you've verified with Resend.
EMAIL_FROM_ADDRESS=

# --- Spotify (playlist auto-build) ---
# Optional — without these, shipping a drop just needs the Spotify link
# pasted in by hand, same as before this existed. See README.md
# "6. Spotify (playlist auto-build)" for how to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- App config ---
# Shown in confirmation/release messages.
NEXT_PUBLIC_CLUB_NAME="Music Club"

# The code curators enter to join (format like GOOBERZ-4821). Shown to
# them by whoever invites them — a curator with access can also see/copy
# it from /settings.
CLUB_JOIN_CODE=

# A password you make up yourself — protects /api/send and /api/drops
# so only you can trigger a manual send or start a new drop.
ADMIN_SECRET=

# A second password you make up yourself — Vercel automatically sends this
# as a Bearer token when it calls /api/cron/send on schedule. Set the exact
# same value here and in Vercel's project environment variables.
CRON_SECRET=

# A long random string you make up yourself — signs the curator login
# session cookie. Changing it logs every curator out. Generate one with
# `openssl rand -hex 32`.
SESSION_SECRET=
